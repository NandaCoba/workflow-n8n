    {
      "parameters": {
        "jsCode": "const esc=v=>String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nreturn $input.all().map(item=>{const j=item.json; const salary=j.salary?`\\n💰 <b>Salary:</b> ${esc(j.salary)}`:''; const published=j.publishedAt?esc(String(j.publishedAt)):'Unknown'; const msg=`🚀 <b>NEW BACKEND JOB</b>\\n\\n💼 <b>${esc(j.title)}</b>\\n🏢 ${esc(j.company||'Unknown company')}\\n📍 ${esc(j.location||'Remote')}\\n🧾 ${esc(j.jobType||'Not specified')}${salary}\\n\\n🕒 <b>Published:</b> ${published}\\n🌐 <b>Source:</b> ${esc(j.source)}\\n\\n🔗 <a href=\\\"${esc(j.url)}\\\">Open & Apply</a>`; return {json:{...j,telegramMessage:msg}};});"
      },
