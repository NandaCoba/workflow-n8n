    {
      "parameters": {
        "jsCode": "return $input.all().map(i=>{const j=i.json||{}; const t=j.title||''; const parts=t.split(':'); return {json:{id:String(j.guid||j.link||t),title:(parts.length>1?parts.slice(1).join(':'):t).trim(),company:(parts.length>1?parts[0]:'').trim(),location:'Remote',jobType:'Remote',salary:'',tags:[],publishedAt:j.isoDate||j.pubDate||'',url:j.link||'',source:'WeWorkRemotely',description:j.contentSnippet||j.content||''}}});"
      },
