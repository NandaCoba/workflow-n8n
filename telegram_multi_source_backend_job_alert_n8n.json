    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG - EDIT ME').first().json;\nconst keywords=String(cfg.keywords||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);\nconst allowed=String(cfg.allowedLocations||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);\nconst strip=s=>String(s||'').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<[^>]*>/g,' ').replace(/&nbsp;/gi,' ').replace(/&amp;/gi,'&').replace(/\\s+/g,' ').trim();\nconst locOk=loc=>{const l=String(loc||'remote').toLowerCase(); return !allowed.length||allowed.some(x=>l.includes(x))||l.includes('remote');};\nconst keyOk=j=>{const h=[j.title,j.company,j.location,(j.tags||[]).join(' '),strip(j.description)].join(' ').toLowerCase(); return keywords.some(k=>h.includes(k));};\nconst seen=new Set();\nconst arr=[];\nfor(const i of $input.all()){const j=i.json||{}; if(!j.title||!j.url||!keyOk(j)||!locOk(j.location)) continue; const k=[j.title,j.company].join('|').toLowerCase().replace(/[^a-z0-9|]+/g,' ').trim(); if(seen.has(k)) continue; seen.add(k); arr.push(i);}\narr.sort((a,b)=>new Date(b.json.publishedAt||0)-new Date(a.json.publishedAt||0));\nreturn arr.slice(0,Number(cfg.maxJobsPerRun||20));"
      },
      "id": "4533fc8c-6860-46b7-b35a-ab97d5ba162b",
      "name": "Filter + Cross-source Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG - EDIT ME').first().json; const store=$getWorkflowStaticData('global'); if(!Array.isArray(store.sentJobKeys)) store.sentJobKeys=[]; const sent=new Set(store.sentJobKeys); const fresh=[]; for(const item of $input.all()){const j=item.json; const key=[j.title,j.company,j.url].join('|').toLowerCase(); if(!sent.has(key)){fresh.push(item); sent.add(key);}} store.sentJobKeys=Array.from(sent).slice(-Number(cfg.maxStoredJobKeys||5000)); return fresh;"
      },
      "id": "995fee92-a684-4ccb-8302-e71f0b13ee42",
      "name": "Skip Already Sent",
