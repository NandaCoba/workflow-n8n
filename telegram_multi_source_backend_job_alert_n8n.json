    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG - EDIT ME').first().json;\nconst first=$input.first().json;\nconst html=typeof first==='string'?first:(first.body||first.data||first.html||JSON.stringify(first));\nconst decode=s=>String(s||'').replace(/&amp;/g,'&').replace(/&#x27;|&#39;/g,\"'\").replace(/&quot;/g,'\\\"').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim();\nconst out=[];\nconst blocks=String(html).split(/<li>/i).slice(1);\nfor(const b of blocks){\n const id=(b.match(/data-entity-urn=\\\"urn:li:jobPosting:(\\d+)/i)||[])[1]||'';\n const href=decode((b.match(/base-card__full-link[^>]*href=\\\"([^\\\"]+)/i)||[])[1]||'');\n const title=decode((b.match(/base-search-card__title[^>]*>([\\s\\S]*?)<\\//i)||[])[1]||'');\n const company=decode((b.match(/base-search-card__subtitle[^>]*>[\\s\\S]*?<a[^>]*>([\\s\\S]*?)<\\/a>/i)||[])[1]||(b.match(/base-search-card__subtitle[^>]*>([\\s\\S]*?)<\\//i)||[])[1]||'');\n const location=decode((b.match(/job-search-card__location[^>]*>([\\s\\S]*?)<\\//i)||[])[1]||'Remote');\n const dt=(b.match(/datetime=\\\"([^\\\"]+)/i)||[])[1]||'';\n if(title&&href) out.push({json:{id:String(id||href),title,company,location,jobType:'Remote',salary:'',tags:[],publishedAt:dt,url:href.split('?')[0],source:'LinkedIn',description:''}});\n}\nreturn out;"
      },
