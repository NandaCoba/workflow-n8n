        "jsCode": "const raw=$input.first().json; const a=Array.isArray(raw)?raw:(Array.isArray(raw.data)?raw.data:[]);\nreturn a.filter(j=>j&&j.position).map(j=>({json:{id:String(j.id||j.url),title:j.position||'',company:j.company||'',location:j.location||'Remote',jobType:'Remote',salary:j.salary||'',tags:Array.isArray(j.tags)?j.tags:[],publishedAt:j.date||j.epoch||'',url:j.url||j.apply_url||'',source:'RemoteOK',description:j.description||''}}));"
